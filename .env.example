# Puerto del servidor (opcional, por defecto 3000)
PORT= x

# Conexión a MongoDB (local o URI de Atlas)
MONGODB_URI= x

# Clave para firmar los tokens JWT
JWT_SECRET= x

# Duración del token (opcional, por defecto 2h)
JWT_EXPIRES_IN= 2h

# Origen del frontend permitido por CORS (Vite usa 5173 por defecto)
CLIENT_URL= x